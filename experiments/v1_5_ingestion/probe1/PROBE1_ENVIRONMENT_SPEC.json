{
  "$schema": "https://raw.githubusercontent.com/guarnieriagustincyber/TALOS/main/schemas/probe1_environment_spec.schema.json",
  "environment_id": "env_probe1_colab_v1",
  "created_at": "2026-10-05T23:51:00Z",
  "governance": {
    "execution_mode": "COLAB_FIRST",
    "local_execution": "FORBIDDEN",
    "status": "FROZEN_SPECIFICATION",
    "production_selection": "NOT_PERFORMED",
    "v1_runtime_modified": false,
    "database_changes": 0
  },
  "runtime": {
    "os": "Linux (Ubuntu 22.04 LTS / Colab standard)",
    "python_version": ">=3.10, <=3.12",
    "hardware_target": {
      "accelerators_supported": [
        "CPU",
        "GPU_T4",
        "GPU_A100"
      ],
      "recommended_accelerator": "GPU_T4",
      "ram_min_gb": 12.0,
      "disk_min_gb": 20.0
    }
  },
  "dependencies": {
    "core_extractors": [
      {
        "name": "pymupdf",
        "pinned_version": "1.24.1",
        "role": "Fast baseline extraction and rapid geometric inspection"
      },
      {
        "name": "pypdf",
        "pinned_version": "4.2.0",
        "role": "Deterministic plain-text compatibility baseline"
      },
      {
        "name": "docling",
        "pinned_version": "2.5.2",
        "role": "Layout-aware structural extractor & TableFormer"
      }
    ],
    "supporting_libraries": [
      {
        "name": "torch",
        "pinned_version": ">=2.1.0",
        "role": "Neural inference backend for Docling layout models"
      },
      {
        "name": "pydantic",
        "pinned_version": ">=2.0.0",
        "role": "Schema validation and telemetry serialization"
      }
    ]
  },
  "reproducibility": {
    "global_seed": 42,
    "python_hash_seed": "42",
    "torch_deterministic": true
  },
  "benchmark_protocol": {
    "warmup_runs": 2,
    "measurement_iterations": 5,
    "timer_function": "time.perf_counter()",
    "metrics_collected": [
      "mean_latency_ms",
      "median_latency_ms",
      "p95_latency_ms",
      "std_latency_ms",
      "peak_memory_mb"
    ]
  }
}